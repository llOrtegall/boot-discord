DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here

# Song cache (optional — defaults shown)
# Requires `yt-dlp` installed and available in PATH.
CACHE_DB_PATH=./.cache/songs.db
CACHE_AUDIO_DIR=./.cache/audio
CACHE_TTL_DAYS=7

# YouTube anti-bot (needed on VPS/datacenter IPs that get
# "Sign in to confirm you're not a bot").
# Netscape-format cookies.txt from a logged-in (throwaway) YouTube account.
# Mount the file at /app/cookies.txt:ro — the entrypoint copies it to a
# writable path automatically (yt-dlp rewrites the jar on exit).
# YT_DLP_COOKIES=/app/cookies.txt
# Last resort, no account. Can cause "Requested format is not available" and
# usually does NOT accept cookies — leave unset when YT_DLP_COOKIES works:
# YT_DLP_EXTRACTOR_ARGS=youtube:player_client=tv
