DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here

# Song cache (optional — defaults shown)
# Requires `yt-dlp` installed and available in PATH.
CACHE_DB_PATH=./.cache/songs.db
CACHE_AUDIO_DIR=./.cache/audio
CACHE_TTL_DAYS=7

# YouTube anti-bot (needed on VPS/datacenter IPs that get
# "Sign in to confirm you're not a bot"). Set one or both.
# Path to a Netscape-format cookies.txt from a logged-in YouTube account:
# YT_DLP_COOKIES=/app/cookies.txt
# Raw --extractor-args value (try before cookies; often not enough):
# YT_DLP_EXTRACTOR_ARGS=youtube:player_client=tv
